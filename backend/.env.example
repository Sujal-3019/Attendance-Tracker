# Copy to .env and replace placeholders locally. Never commit .env.
DATABASE_URL=postgresql+psycopg://postgres:replace-me@localhost:5432/attendance_tracker
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
ADMIN_SETUP_CODE=replace-with-a-private-one-time-code-at-least-32-characters
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=15
